aws_access_key_id: your-access-key-id
aws_region: us-east-1
aws_secret_access_key: your-secret-access-key
max_concurrent_uploads: 100
s3_bucket: your-bucket-name
s3_prefix: backup
web_enabled: true
web_port: 8765
# Keys are container paths — must match the mount points in docker-compose.yml, not
# host/NAS paths. Values are the S3 folder name each one is uploaded under.
watch_folders:
  /data/pictures: Pictures
